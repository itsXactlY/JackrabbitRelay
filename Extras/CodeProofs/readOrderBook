import sys
sys.path.append('/home/GitHub/JackrabbitRelay/Base/Library')
import os
import json

import JackrabbitRelay as JRR

Blank=" "

###
### Main code base. Place order on exchange
###

relay=JRR.JackrabbitRelay()
if relay.GetArgsLen()>4:
    exchangeName=relay.GetExchange()
    account=relay.GetAccount()
    asset=relay.GetAsset()
    depth=int(relay.GetArgs(4))
else:
    print("An exchange, (sub)account, an asset, and depth must be provided.")
    sys.exit(1)

markets=relay.GetMarkets()
ticker=relay.GetTicker(symbol=asset)
orderbook=relay.GetOrderBook(symbol=asset)

if relay.GetFramework()=='mimic':
    relay.Framework=relay.Broker.Framework

if relay.GetFramework()=='ccxt':
    BuyPrice=round(float(ticker['Ask']),8)
    SellPrice=round(float(ticker['Bid']),8)

    # Variables for order book

    lp=0
    sp=0
    buyIDX=0
    sellIDX=0
    l=min(len(orderbook['asks']),len(orderbook['bids']))-1

    obl=[]
    oblB=[]
    oblS=[]

    # This table denotes the order book prices by volume. Prices are rounded to pips.
    # 0 price
    # 1 volume at given price
    # 2 count
    # 3 depth of market

    BuyTable=[]

    idx=0
    ppB=0
    ppS=0
    for ob in range(l):
        bprice=round(orderbook['bids'][ob][0],8)
        buy=orderbook['bids'][ob][1] #*bprice

        sprice=round(orderbook['asks'][ob][0],8)
        sell=orderbook['asks'][ob][1] #*sprice

        cpB=bprice
        if ppB<BuyPrice and BuyPrice<=cpB:
            buyIDX=idx

        cpS=sprice
        if ppS<SellPrice and SellPrice<=cpS:
            sellIDX=idx

        lp+=buy
        sp+=sell

        oblB.append([buy,bprice])
        oblS.append([sell,sprice])
        ppB=cpB
        ppS=cpS
        idx+=1

    print(f"{Blank:4} {'Volume':>12} {'Buy':>12} {'Sell':>12} {'Volume':>12} {'Spread':>12}")
    print(f"{Blank:4} {Blank:12} {BuyPrice:12.5f} {SellPrice:12.5f} {Blank:12} {BuyPrice-SellPrice:12.5f}")
    print(f"{'-'*4:4} {'-'*12:12} {'-'*12:12} {'-'*12:12} {'-'*12:12} {'-'*12:12}")

    c=1
    maxBorders=0
    maxSorders=0
    maxBprice=0
    maxSprice=0
    for i in range(depth):
        buy=oblB[buyIDX+i][0]
        bprice=oblB[buyIDX+i][1]

        sprice=oblS[sellIDX+i][1]
        sell=oblS[sellIDX+i][0]

        spread=sprice-bprice

        if buy>maxBorders:
            maxBorders=buy
            maxBprice=bprice
        if sell>maxSorders:
            maxSorders=sell
            maxSprice=sprice
        print(f"{c:4} {buy:12.5f} {bprice:12.5f} {sprice:12.5f} {sell:12.5f} {spread:12.5f}")
        c+=1

    spread=maxSprice-maxBprice
    print(f"{'-'*4:4} {'-'*12:12} {'-'*12:12} {'-'*12:12} {'-'*12:12} {'-'*12:12}")
    print(f"MAX  {maxBorders:12.5f} {maxBprice:12.5f} {spread:12.5f} {maxSprice:12.5f} {maxSorders:12.5f}")

elif relay.GetFramework() == 'ccapi':
    import fast_mssql, json

    CONN_STR = (
        "DRIVER={ODBC Driver 18 for SQL Server};"
        "SERVER=localhost;"
        "DATABASE=BTQ_MarketData;"
        "UID=SA;"
        "PWD=q?}33YIToo:H%xue$Kr*;"
        "TrustServerCertificate=yes;"
    )

    raw_symbol = asset
    exchange   = exchangeName

    s1 = raw_symbol.replace("/", "-")
    s2 = raw_symbol.replace("/", "")
    symbols_list = {raw_symbol, s1, s2}
    symbols_in = "', '".join(symbols_list)

    # NOLOCK and FORCESEEK to prevent blocking
    sql = f"""
    SELECT TOP (1) bids, asks, [timestamp]
    FROM dbo.orderbook_snapshots WITH (NOLOCK, FORCESEEK)
    WHERE exchange = '{exchange}'
      AND symbol IN ('{symbols_in}')
      AND market_type = 'spot'
    ORDER BY [timestamp] DESC
    OPTION (MAXDOP 1);
    """

    rows = fast_mssql.fetch_data_from_db(CONN_STR, sql)
    
    if not rows:
        print(f"No orderbook snapshot in DB for {exchange} {raw_symbol}")
        sys.exit(1)
    
    bids_json, asks_json, ts = rows[0]
    bids = json.loads(bids_json) if isinstance(bids_json, str) else bids_json
    asks = json.loads(asks_json) if isinstance(asks_json, str) else asks_json
    
    print(f"✅ Latest orderbook snapshot ({ts}):")
    print(f"   Best Bid: {bids[0] if bids else 'N/A'}")
    print(f"   Best Ask: {asks[0] if asks else 'N/A'}")

    if not bids or not asks:
        print("Orderbook snapshot has no bids/asks.")
        sys.exit(1)

    # effective depth = min(requested depth, available levels)
    eff_depth = min(depth, len(bids), len(asks))

    # Use best bid / ask from the snapshot
    BuyPrice  = float(bids[0][0])
    SellPrice = float(asks[0][0])

    print(f"{Blank:4} {'Volume':>12} {'Buy':>12} {'Sell':>12} {'Volume':>12} {'Spread':>12}")
    print(f"{Blank:4} {Blank:12} {BuyPrice:12.5f} {SellPrice:12.5f} {Blank:12} {BuyPrice-SellPrice:12.5f}")
    print(f"{'-'*4:4} {'-'*12:12} {'-'*12:12} {'-'*12:12} {'-'*12:12} {'-'*12:12}")

    maxBorders = 0.0
    maxSorders = 0.0
    maxBprice  = 0.0
    maxSprice  = 0.0

    for i in range(eff_depth):
        bpx, bqty = float(bids[i][0]), float(bids[i][1])
        apx, aqty = float(asks[i][0]), float(asks[i][1])
        spread    = apx - bpx

        if bqty > maxBorders:
            maxBorders = bqty
            maxBprice  = bpx
        if aqty > maxSorders:
            maxSorders = aqty
            maxSprice  = apx

        print(f"{i+1:4} {bqty:12.5f} {bpx:12.5f} {apx:12.5f} {aqty:12.5f} {spread:12.5f}")

    spread = maxSprice - maxBprice
    print(f"{'-'*4:4} {'-'*12:12} {'-'*12:12} {'-'*12:12} {'-'*12:12} {'-'*12:12}")
    print(f"MAX  {maxBorders:12.5f} {maxBprice:12.5f} {spread:12.5f} {maxSprice:12.5f} {maxSorders:12.5f}")